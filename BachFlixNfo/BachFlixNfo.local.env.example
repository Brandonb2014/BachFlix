# Copy this file to BachFlixNfo.local.env and fill in local values.
# BachFlixNfo.local.env is ignored by git.

TMDB_API_KEY=
TMDB_LIST_ID=
TMDB_SESSION_ID=
YOUTUBE_API_KEY=
# Audio Censor / WhisperX
AUDIO_CENSOR_WHISPERX_PATH=
AUDIO_CENSOR_WHISPERX_MODEL=small
AUDIO_CENSOR_WHISPERX_DEVICE=cpu
AUDIO_CENSOR_WHISPERX_COMPUTE_TYPE=int8
AUDIO_CENSOR_WHISPERX_LANGUAGE=en
AUDIO_CENSOR_CENSORED_AUDIO_CODEC=flac
AUDIO_CENSOR_SRT_ONLY_MIN_DURATION_MS=180
AUDIO_CENSOR_SRT_ONLY_MAX_DURATION_MS=450
AUDIO_CENSOR_SRT_ONLY_DEFAULT_MUTE_DURATION_MS=180
AUDIO_CENSOR_SRT_ONLY_PRE_PADDING_MS=80
AUDIO_CENSOR_SRT_ONLY_POST_PADDING_MS=120
AUDIO_CENSOR_SRT_ONLY_CONTEXT_WINDOW_BEFORE_MS=2000
AUDIO_CENSOR_SRT_ONLY_CONTEXT_WINDOW_AFTER_MS=2000
AUDIO_CENSOR_WHISPER_PRE_PADDING_MS=120
AUDIO_CENSOR_WHISPER_POST_PADDING_MS=160
AUDIO_CENSOR_MERGE_GAP_MS=60
AUDIO_CENSOR_SUBTITLE_REPLACEMENT_MODE=AsterisksSameLength
AUDIO_CENSOR_SUBTITLE_REPLACEMENT_TEXT=[censored]
# Legacy alias: asterisks, *, or a fixed text value.
AUDIO_CENSOR_SUBTITLE_REPLACEMENT=asterisks
AUDIO_CENSOR_KEEP_WORK_FILES=false
